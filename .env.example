POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moeda_estudantil
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moeda_estudantil
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Segredo que assina o token de login; troque por um texto longo e aleatório
JWT_SEGREDO=troque-este-segredo-no-env

# E-mails (Gmail): informe o seu e-mail e uma senha de aplicativo.
# Sem usuário e senha, o sistema não envia e-mails e só mostra o conteúdo no log da API.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
